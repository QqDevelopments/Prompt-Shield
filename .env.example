# Local Compose setup. Copy to .env and replace the required secrets.
# Never commit .env or reuse synthetic test credentials.
ENVIRONMENT=development
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Hosted overlay: set PUBLIC_ORIGIN=https://prompt-shield.qqdevelopments.com
# Frontend Vercel API_BASE_URL is separate; see docs/HOSTING.md.
ORGANIZATION_ID=community
DEPLOYMENT_MODE=self-hosted
PUBLIC_ENABLED=true
# Required when public endpoints are enabled: independent random secret, 32+ characters.
PUBLIC_HMAC_KEY=
# Comma-separated exact frontend origins, without trailing slash. No wildcards.
ALLOWED_ORIGINS=
# Empty trusts no forwarded headers. Restrict to the actual ingress addresses.
TRUSTED_PROXY_CIDRS=
# Public daily cap defaults to 5/IP/UTC day outside development. Strict true/false.
PUBLIC_DAILY_IP_LIMIT_ENABLED=true
# Disables only the public minute/per-IP concurrency checks; global capacity stays on.
PUBLIC_IP_RATE_LIMIT_ENABLED=true
QUEUE_MAX_RUNNING=2
QUEUE_MAX_WAITING=20
QUEUE_WAIT_TIMEOUT_SECONDS=30
PUBLIC_REQUESTS_PER_MINUTE=10
PUBLIC_CONCURRENT_PER_IP=2
PUBLIC_CONCURRENT_GLOBAL=20
# Required: 16-72 bytes; use a randomly generated password.
OPERATOR_PASSWORD=
# Required: at least 32 ASCII characters; use a different random secret.
ENGINE_TOKEN=
# Required: random hex password, URL-safe in the Compose database URL.
POSTGRES_PASSWORD=
# Optional only for authenticated self-hosted integrations; hosted mode rejects these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Run node --no-warnings --experimental-strip-types scripts/fetch-model.ts before enabling.
NER_ENABLED=false
# Startup pool settings; sessions/threads each 1,2,4 and product at most 8.
NER_SESSION_COUNT=1
NER_INTRA_THREADS=4
NER_SPINNING=true
DAILY_TOKEN_BUDGET=1000000
AUDIT_RETENTION_DAYS=30
# Optional: at least 32 characters enables authenticated metrics.
METRICS_TOKEN=
# Native processes only; Compose configures these internally.
# GATEWAY_LISTEN=127.0.0.1:8080
# ENGINE_LISTEN=127.0.0.1:50051
# RUST_ENGINE_ADDR=127.0.0.1:50051
# DATABASE_URL=postgres://promptshield:URL_SAFE_PASSWORD@127.0.0.1:15432/promptshield?sslmode=disable
# REDIS_URL=redis://127.0.0.1:16379/0
# CONSOLE_ASSETS=../../apps/web-console/dist
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ONNX_MODEL_PATH=../../models/general-ner/model.onnx
# TOKENIZER_CONFIG_PATH=../../models/general-ner/tokenizer.json
