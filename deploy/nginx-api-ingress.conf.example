# Merge with the existing TLS virtual host; retain the certificate paths.
# Apply the operator's IP allowlist here until hosted acceptance is complete.
location ^~ /ingress/ {
    return 404;
}
location / {
    proxy_pass http://127.0.0.1:8084;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
    proxy_read_timeout 405s;
}
